# ==============================================
# 🗄️ DATABASE (PostgreSQL) — WAJIB
# ==============================================
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ==============================================
# 🔐 AUTH (NextAuth) — WAJIB
# ==============================================
AUTH_SECRET="ganti-dengan-string-acak-panjang"
AUTH_TRUST_HOST="true"

# ==============================================
# 🌐 URL PUBLIK — sesuaikan dengan domain deploy
# ==============================================
BASE_URL="https://your-app.example.com"
NEXTAUTH_URL="https://your-app.example.com"
NEXT_PUBLIC_APP_URL="https://your-app.example.com"
NEXT_PUBLIC_API_URL="https://your-app.example.com/api"

# ==============================================
# 🚀 APP
# ==============================================
NODE_ENV="production"
PORT="3030"
APP_NAME="WA-AKG"
TZ="Asia/Jakarta"

# ==============================================
# 📚 Swagger UI (opsional) — login halaman /swagger
# ==============================================
NEXT_PUBLIC_SWAGGER_USERNAME="admin"
NEXT_PUBLIC_SWAGGER_PASSWORD="ganti-password-ini"

# ==============================================
# 💳 PAYMENT (KlikQRIS) — OPSIONAL
# Lebih baik diatur lewat dashboard (Settings > Payment Gateway, SUPERADMIN).
# Ini hanya fallback kalau DB kosong.
# ==============================================
KLIKQRIS_BASE_URL="https://klikqris.com/api"
KLIKQRIS_API_KEY=""
KLIKQRIS_MERCHANT_ID=""

# ==============================================
# 🔒 SECURITY (opsional)
# ==============================================
# Batasi CORS API ke origin tertentu (default "*"/semua bila kosong).
# Set ke domain dashboard-mu untuk memperketat, mis: https://shopeelive.me
CORS_ALLOW_ORIGIN=""
